@mobiscroll:registry=https://npm.mobiscroll.com
# トークンは環境変数 MOBISCROLL_TOKEN から読む（リポジトリには書かない）。
# ローカル: export MOBISCROLL_TOKEN=... / GitHub Actions: Secrets / Netlify: Environment variables。
//npm.mobiscroll.com/:_authToken=${MOBISCROLL_TOKEN}
# @mobiscroll/react は npm:@mobiscroll/react-next-trial のエイリアスで、公開名が
# 一致しないため pnpm のストア整合チェックに引っかかる。CI/ローカルでの
# インストール失敗(ERR_PNPM_UNEXPECTED_PKG_CONTENT_IN_STORE)を防ぐため無効化。
strict-store-pkg-content-check=false
