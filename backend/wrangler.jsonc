{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lotsizing-elliott",
  "main": "src/entry.py",
  // Python Workers の有効化（GA は 2026-09-21。日付は 2026-09-23 以降が必要）
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["python_workers"],
  // 損切り提案(/stoploss)が強弱・取引量を取得する既存 Worker のベースURL。
  "vars": {
    "STRENGTH_WORKER_URL": "https://currency-strength.ozawa19890413.workers.dev"
  },
  // 必須 secret（`wrangler secret put` で登録。宣言しておくと未設定デプロイを弾ける）:
  //   OANDA_API_TOKEN … OANDA practice の個人アクセストークン（通知機能と同じ値）
  "secrets": ["OANDA_API_TOKEN"]
}
