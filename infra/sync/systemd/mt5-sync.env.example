# /etc/mt5-sync.env に配置（権限 600 推奨）。値はご自身のものに置き換える。
# Turso の接続情報（turso db show <db> --url / turso db tokens create <db>）。
TURSO_DATABASE_URL=libsql://your-db-xxxx.turso.io
TURSO_AUTH_TOKEN=eyJ...your-token...
# EA の出力ディレクトリ（Wine プレフィックス内の MQL5/Files/mt5sync の実パス）。
# 例: /home/ubuntu/.wine/drive_c/users/ubuntu/AppData/Roaming/MetaQuotes/Terminal/<ID>/MQL5/Files/mt5sync
MT5_SYNC_DIR=/home/ubuntu/.wine/drive_c/users/ubuntu/AppData/Roaming/MetaQuotes/Terminal/XXXXXXXX/MQL5/Files/mt5sync
