# MetaTrader5 を Wine + Xvfb(:99) でヘッドレス常駐する。
# 配置: /etc/systemd/system/mt5.service
# ※ MT5 導入・初回ログイン・EA適用が済んでから有効化すること（enable --now mt5.service）。
# ※ terminal64.exe のパスはブローカーのインストール先に合わせて調整する。
[Unit]
Description=MetaTrader5 terminal (headless via Wine on :99)
After=xvfb.service
Requires=xvfb.service

[Service]
User=ubuntu
Environment=DISPLAY=:99
Environment=WINEPREFIX=/home/ubuntu/.wine
Environment=WINEDEBUG=-all
ExecStart=/usr/bin/wine "/home/ubuntu/.wine/drive_c/Program Files/MetaTrader 5/terminal64.exe"
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
