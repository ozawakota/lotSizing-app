VITE_EXCHANGERATE_API_KEY=your_api_key_here
# 通貨強弱を配信する Cloudflare Worker の URL（未設定なら強弱は表示されない）
# Worker のセットアップは worker/README.md を参照。Twelve Data キーは Worker シークレット側に保持。
VITE_STRENGTH_URL=https://currency-strength.your-subdomain.workers.dev
# 取引量・センチメント ページ（同じ Worker の /flow パス。未設定ならページは「—」のまま）
# 追加で Myfxbook 無料アカウントが必要（worker/README.md 参照）。
VITE_FLOW_URL=https://currency-strength.your-subdomain.workers.dev/flow
