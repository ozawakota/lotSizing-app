VITE_EXCHANGERATE_API_KEY=your_api_key_here
# 通貨強弱を配信する Cloudflare Worker の URL（未設定なら強弱は表示されない）
# Worker のセットアップは worker/README.md を参照。Twelve Data キーは Worker シークレット側に保持。
VITE_STRENGTH_URL=https://currency-strength.your-subdomain.workers.dev
# 取引量・センチメント ページ（同じ Worker の /flow パス。未設定ならページは「—」のまま）
# 追加で Myfxbook 無料アカウントが必要（worker/README.md 参照）。
VITE_FLOW_URL=https://currency-strength.your-subdomain.workers.dev/flow
# 相場変動通知（外貨ex 準拠）。未設定ならカードは非表示。
# セットアップは alert-worker/README.md を参照。両方セットで有効化される。
VITE_ALERT_URL=https://lotsizing-alert.your-subdomain.workers.dev
# Alert Worker と同じ VAPID 公開鍵（`npx web-push generate-vapid-keys` の publicKey）。
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
# エリオット波動/損切り提案の backend（Cloudflare Python Worker）。未設定なら損切りページは案内のみ。
# セットアップは backend/README.md を参照。
VITE_BACKEND_URL=https://lotsizing-elliott.your-subdomain.workers.dev
